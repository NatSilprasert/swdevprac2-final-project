{
  "name": "equipment-rental-system",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "web:dev": "yarn workspace web dev",
    "web:build": "yarn workspace web build",
    "web:typecheck": "yarn workspace web typecheck",
    "api:dev": "yarn workspace api dev",
    "api:start": "yarn workspace api start",
    "db:seed": "yarn workspace api seed",
    "db:up": "docker compose -f apps/api/docker-compose.yml up -d",
    "db:stop": "docker compose -f apps/api/docker-compose.yml stop",
    "db:down": "docker compose -f apps/api/docker-compose.yml down"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.9.2"
}
